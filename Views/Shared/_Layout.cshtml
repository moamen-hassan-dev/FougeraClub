@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@using FougeraClub1.Models

@functions {
    public string IsActive(string controller, params string[] actions)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        if (string.IsNullOrEmpty(currentController) || string.IsNullOrEmpty(currentAction))
            return "";
        return currentController.Equals(controller, StringComparison.OrdinalIgnoreCase) &&
               actions.Any(a => a.Equals(currentAction, StringComparison.OrdinalIgnoreCase))
            ? "active-text"
            : "";
    }
    public string IsExpanded(params string[] controllers)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        if (string.IsNullOrEmpty(currentController)) return "";
        return controllers.Any(c => c.Equals(currentController, StringComparison.OrdinalIgnoreCase))
            ? "show"
            : "";
    }
    public string IsActiveBG(string controller, params string[] actions)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        if (string.IsNullOrEmpty(currentController) || string.IsNullOrEmpty(currentAction))
            return "side-nav-item";
        return currentController.Equals(controller, StringComparison.OrdinalIgnoreCase) &&
               actions.Any(a => a.Equals(currentAction, StringComparison.OrdinalIgnoreCase))
            ? "side-nav-item active-background"
            : "side-nav-item";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fougera Purchase Orders</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="~/css/site.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="shortcut icon" href="~/favicon.ico">
    <link href="~/css/index.css" rel="stylesheet" />
    <link href="~/assets/css/vendor.min.css" rel="stylesheet" type="text/css" />
    <script src="~/assets/js/sweetalert2@11.js"></script>
    <link href="~/assets/css/app.min.css" rel="stylesheet" type="text/css" id="app-style" />
    <link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <script>
        document.documentElement.setAttribute('data-sidenav-size', 'default');
        document.documentElement.setAttribute('data-layout-mode', 'light');
        document.documentElement.setAttribute('data-topbar-color', 'light');
        document.documentElement.setAttribute('data-menu-color', 'light');
        document.documentElement.setAttribute('data-layout-width', 'fluid');
        document.documentElement.setAttribute('data-layout-position', 'fixed');
        document.documentElement.setAttribute('data-sidenav-user', 'false');
    </script>
</head>
<body>
    <!-- Top Navbar -->
    <nav class="custom-navbar">
        <div class="navbar-left">
            <button class="nav-toggle" id="sideBtn2">
                <i class="fa-solid fa-bars"></i>
            </button>
            <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">
                <img src="~/ar/assets/images/logo-ar.png" alt="Logo" style="height:32px;" onerror="this.style.display='none'" />
            </a>
            <h4 class="navbar-title">Fougera Purchase Orders</h4>
        </div>
        <div class="d-flex align-items-center">
            @if (SignInManager.IsSignedIn(User))
            {
                <span class="me-3" style="font-size:13px; color:#6c757d;">
                    <i class="fa-solid fa-user-circle me-1"></i>
                    <strong>@UserManager.GetUserName(User)</strong>
                </span>
            }
        </div>
    </nav>

    <!-- Sidebar -->
    <div class="sidenav-menu">
        <ul class="side-nav">
            <li class="@IsActiveBG("Dashboard", "Index")">
                <a asp-controller="Dashboard" asp-action="Index" class="side-nav-link">
                    <span class="menu-icon"><i class="fa-solid fa-gauge-high"></i></span>
                    <span class="fw menu-text @IsActive("Dashboard", "Index")">Dashboard</span>
                </a>
            </li>

            <li class="side-nav-item">
                <a data-bs-toggle="collapse" href="#sidebarPO"
                   aria-expanded="@(IsExpanded("PurchaseOrders", "PurchaseOrderItems") != "" ? "true" : "false")"
                   aria-controls="sidebarPO"
                   class="side-nav-link">
                    <span class="menu-icon"><i class="fa-solid fa-cart-shopping"></i></span>
                    <span class="fw menu-text">Purchase Orders</span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="collapse @IsExpanded("PurchaseOrders", "PurchaseOrderItems")" id="sidebarPO">
                    <ul class="sub-menu border-start-0">
                        <li class="@IsActiveBG("PurchaseOrders", "Index")">
                            <a asp-controller="PurchaseOrders" asp-action="Index" class="side-nav-link">
                                <span class="menu-icon"><i class="fa-solid fa-list"></i></span>
                                <span class="fw menu-text @IsActive("PurchaseOrders", "Index")">All Orders</span>
                            </a>
                        </li>
                        <li class="@IsActiveBG("PurchaseOrders", "Create")">
                            <a asp-controller="PurchaseOrders" asp-action="Create" class="side-nav-link">
                                <span class="menu-icon"><i class="fa-solid fa-plus-circle"></i></span>
                                <span class="fw menu-text @IsActive("PurchaseOrders", "Create")">New Order</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </li>

            <li class="side-nav-item">
                <a data-bs-toggle="collapse" href="#sidebarSuppliers"
                   aria-expanded="@(IsExpanded("Suppliers") != "" ? "true" : "false")"
                   aria-controls="sidebarSuppliers"
                   class="side-nav-link">
                    <span class="menu-icon"><i class="fa-solid fa-industry"></i></span>
                    <span class="fw menu-text">Suppliers Management</span>
                    <span class="menu-arrow"></span>
                </a>
                <div class="collapse @IsExpanded("Suppliers")" id="sidebarSuppliers">
                    <ul class="sub-menu border-start-0">
                        <li class="@IsActiveBG("Suppliers", "Index")">
                            <a asp-controller="Suppliers" asp-action="Index" class="side-nav-link">
                                <span class="menu-icon"><i class="fa-solid fa-list"></i></span>
                                <span class="fw menu-text @IsActive("Suppliers", "Index")">Suppliers</span>
                            </a>
                        </li>
                        <li class="@IsActiveBG("Suppliers", "Create")">
                            <a asp-controller="Suppliers" asp-action="Create" class="side-nav-link">
                                <span class="menu-icon"><i class="fa-solid fa-plus-circle"></i></span>
                                <span class="fw menu-text @IsActive("Suppliers", "Create")">Add New Supplier</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </li>

            @if (User.IsInRole("Manager"))
            {
                <li class="@IsActiveBG("Users", "Index", "Create")">
                    <a asp-controller="Users" asp-action="Index" class="side-nav-link">
                        <span class="menu-icon"><i class="fa-solid fa-users"></i></span>
                        <span class="fw menu-text @IsActive("Users", "Index", "Create")">User Management</span>
                    </a>
                </li>

                <li class="@IsActiveBG("Logs", "Index")">
                    <a asp-controller="Logs" asp-action="Index" class="side-nav-link">
                        <span class="menu-icon"><i class="fa-solid fa-clipboard-list"></i></span>
                        <span class="fw menu-text @IsActive("Logs", "Index")">Logs View</span>
                    </a>
                </li>
            }

            <li class="@IsActiveBG("Profile", "Index")">
                <a asp-controller="Profile" asp-action="Index" class="side-nav-link">
                    <span class="menu-icon"><i class="fa-solid fa-user"></i></span>
                    <span class="fw menu-text @IsActive("Profile", "Index")">Profile</span>
                </a>
            </li>

            <li class="side-nav-item">
                <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                    <button type="submit" class="side-nav-link border-0 bg-transparent w-100 text-start">
                        <span class="menu-icon"><i class="fa-solid fa-right-from-bracket"></i></span>
                        <span class="fw menu-text">Sign Out</span>
                    </button>
                </form>
            </li>
        </ul>
    </div>

    <!-- Page Content -->
    <div class="page-content d-flex flex-column min-vh-100">
        <div id="page-container" class="page-container flex-grow-1 p-3">
            @RenderBody()
        </div>

        <footer class="footer mt-3 border-top bg-white">
            <div class="container-fluid">
                <div class="row align-items-center justify-content-between text-center text-md-start">
                    <div class="col-md-auto">
                        <small class="text-muted">&copy; 2025 Fougera Club — All rights reserved.</small>
                    </div>
                    <div class="col-md-auto">
                        <small class="text-muted">Purchase Orders Module</small>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/vendor.min.js"></script>
    <script src="~/assets/js/sweetalert2@11.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var sideBtn = document.getElementById("sideBtn2");
            var sideState = false;
            if (sideBtn) {
                sideBtn.addEventListener("click", function () {
                    sideState = !sideState;
                    if (sideState) {
                        document.documentElement.setAttribute("data-sidenav-size", "full");
                        document.documentElement.classList.remove("sidebar-enable");
                    } else {
                        if (window.innerWidth <= 768) {
                            document.documentElement.setAttribute("data-sidenav-size", "full");
                        } else {
                            document.documentElement.setAttribute("data-sidenav-size", "default");
                        }
                        document.documentElement.classList.add("sidebar-enable");
                    }
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>