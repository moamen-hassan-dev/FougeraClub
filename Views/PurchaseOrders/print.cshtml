@model FougeraClub1.Models.PurchaseOrder

@{
    Layout = null; // no shared header/nav/sidebar — this is meant to be printed
    var subtotal = Model.Items.Sum(i => i.Quantity * i.UnitPrice);
    var vat = Model.WithVAT ? subtotal * 0.05m : 0m;
    var grandTotal = subtotal + vat;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Purchase Order #@Model.OrderNumber</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            color: #222;
            padding: 30px;
        }

        h1 {
            margin: 0;
            font-size: 22px;
        }

        .header {
            border-bottom: 2px solid #222;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

            .header small {
                color: #666;
            }

        .info {
            margin-bottom: 20px;
        }

            .info td {
                padding: 4px 10px 4px 0;
                vertical-align: top;
            }

                .info td:first-child {
                    color: #666;
                    width: 130px;
                }

        table.items {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

            table.items th, table.items td {
                border: 1px solid #ccc;
                padding: 8px;
                text-align: left;
            }

            table.items th {
                background: #f4f4f4;
            }

            table.items td.num {
                text-align: right;
            }

        .totals {
            width: 300px;
            margin-left: auto;
        }

            .totals td {
                padding: 4px 8px;
            }

                .totals td:last-child {
                    text-align: right;
                }

            .totals tr.grand td {
                border-top: 2px solid #222;
                font-weight: bold;
                font-size: 15px;
                padding-top: 8px;
            }

        .approval {
            margin-top: 60px;
        }

            .approval img {
                max-height: 80px;
            }

        .signature-line {
            border-bottom: 1px solid #222;
            width: 250px;
            padding-bottom: 4px;
            margin-bottom: 6px;
        }

        .signature-meta {
            font-size: 12px;
            color: #555;
        }
        @@media print {
            body

        {
            padding: 0;
        }

        }
    </style>
</head>
<body>

    <div class="header">
        <h1>Fougera Purchase Orders</h1>
        <small>Purchase Order #@Model.OrderNumber</small>
    </div>

    <table class="info">
        <tr>
            <td>Order Date:</td>
            <td>@Model.OrderDate.ToString("yyyy-MM-dd")</td>
        </tr>
        <tr>
            <td>Supplier:</td>
            <td>@Model.Supplier?.Name</td>
        </tr>
        <tr>
            <td>Status:</td>
            <td>@Model.Status</td>
        </tr>
        <tr>
            <td>Created By:</td>
            <td>@Model.CreatedByUser?.Email</td>
        </tr>
    </table>

    <table class="items">
        <thead>
            <tr>
                <th>#</th>
                <th>Description</th>
                <th class="num">Qty</th>
                <th class="num">Unit Price</th>
                <th class="num">Total</th>
            </tr>
        </thead>
        <tbody>
            @{
                int row = 1;
            }
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@row</td>
                    <td>@item.Description</td>
                    <td class="num">@item.Quantity</td>
                    <td class="num">@item.UnitPrice.ToString("N2")</td>
                    <td class="num">@((item.Quantity * item.UnitPrice).ToString("N2"))</td>
                </tr>
                row++;
            }
        </tbody>
    </table>

    <table class="totals">
        <tr>
            <td>Subtotal:</td>
            <td>@subtotal.ToString("N2")</td>
        </tr>
        @if (Model.WithVAT)
        {
            <tr>
                <td>VAT (5%):</td>
                <td>@vat.ToString("N2")</td>
            </tr>
        }
        <tr class="grand">
            <td>Grand Total:</td>
            <td>@grandTotal.ToString("N2")</td>
        </tr>
    </table>

    <div class="approval">
        @if (Model.ApprovedByUser != null)
        {
            <div class="signature-line">
                @if (!string.IsNullOrEmpty(Model.ApprovedByUser.SignatureImagePath))
                {
                    <img src="@Model.ApprovedByUser.SignatureImagePath" alt="Manager Signature" />
                }
                else
                {
                    <span style="color:#aaa;">— no signature on file —</span>
                }
            </div>
            <div class="signature-meta">
                <strong>@Model.ApprovedByUser.Email</strong><br />
                Approved on @(Model.ApprovedDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")
            </div>
        }
        else
        {
            <div class="signature-meta" style="color:#999;">Not yet approved.</div>
        }
    </div>

    <script>window.print();</script>

</body>
</html>