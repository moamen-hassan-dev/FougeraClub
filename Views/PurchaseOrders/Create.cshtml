@model FougeraClub1.Models.CreatePurchaseOrderViewModel

@{
    ViewData["Title"] = "New Purchase Order";
}

<h1>New Purchase Order</h1>
<p>Create a new purchase order</p>

<form asp-action="Create" method="post" id="orderForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row">
        <!-- LEFT: Order Info -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">Order Info</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Supplier</label>
                        <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.SupplierId">
                            <option value="">-- Select --</option>
                        </select>
                        <span asp-validation-for="SupplierId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Order Date</label>
                        <input asp-for="OrderDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="OrderDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="WithVAT" class="form-check-input" id="withVatCheck" />
                        <label class="form-check-label" for="withVatCheck">Apply 5% VAT</label>
                        <div class="form-text">Check to add 5% VAT to the order total</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: Line Items -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Line Items</span>
                    <button type="button" class="btn btn-success btn-sm" id="addRowBtn">+ Add</button>
                </div>
                <div class="card-body">
                    <table class="table" id="itemsTable">
                        <thead>
                            <tr>
                                <th style="width:40px;">#</th>
                                <th>Particular</th>
                                <th style="width:100px;">Qty</th>
                                <th style="width:130px;">Price</th>
                                <th style="width:130px;">Total</th>
                                <th style="width:50px;"></th>
                            </tr>
                        </thead>
                        <tbody id="itemsBody">
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <tr class="item-row">
                                    <td class="row-num">@(i + 1)</td>
                                    <td>
                                        <input name="Items[@i].Description" value="@Model.Items[i].Description"
                                               class="form-control item-desc" />
                                    </td>
                                    <td>
                                        <input name="Items[@i].Quantity" value="@Model.Items[i].Quantity"
                                               type="number" min="1" class="form-control item-qty" />
                                    </td>
                                    <td>
                                        <input name="Items[@i].UnitPrice" value="@Model.Items[i].UnitPrice"
                                               type="number" step="0.01" min="0" class="form-control item-price" />
                                    </td>
                                    <td class="text-end item-total">0.00</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-danger remove-row">×</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="row justify-content-end">
                        <div class="col-md-6">
                            <table class="table table-sm">
                                <tr>
                                    <td>Subtotal</td>
                                    <td class="text-end" id="subtotal">0.00</td>
                                </tr>
                                <tr>
                                    <td>VAT (5%)</td>
                                    <td class="text-end" id="vat">0.00</td>
                                </tr>
                                <tr class="fw-bold">
                                    <td>Grand Total</td>
                                    <td class="text-end" id="grandTotal">0.00</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3 text-end">
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-success">Create</button>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function () {
            const body = document.getElementById('itemsBody');
            const addBtn = document.getElementById('addRowBtn');
            const vatCheck = document.getElementById('withVatCheck');

            // Rewrite the name attributes (Items[0], Items[1], ...) after any row changes
            function renumberRows() {
                const rows = body.querySelectorAll('.item-row');
                rows.forEach((row, idx) => {
                    row.querySelector('.row-num').textContent = (idx + 1);
                    row.querySelector('.item-desc').name = `Items[${idx}].Description`;
                    row.querySelector('.item-qty').name = `Items[${idx}].Quantity`;
                    row.querySelector('.item-price').name = `Items[${idx}].UnitPrice`;
                });
            }

            // Recalculate totals
            function recalc() {
                let subtotal = 0;
                body.querySelectorAll('.item-row').forEach(row => {
                    const qty = parseFloat(row.querySelector('.item-qty').value) || 0;
                    const price = parseFloat(row.querySelector('.item-price').value) || 0;
                    const lineTotal = qty * price;
                    row.querySelector('.item-total').textContent = lineTotal.toFixed(2);
                    subtotal += lineTotal;
                });

                const vat = vatCheck.checked ? subtotal * 0.05 : 0;
                const grand = subtotal + vat;

                document.getElementById('subtotal').textContent = subtotal.toFixed(2);
                document.getElementById('vat').textContent = vat.toFixed(2);
                document.getElementById('grandTotal').textContent = grand.toFixed(2);
            }

            // Build a fresh row (mirrors the Razor markup)
            function buildRow() {
                const tr = document.createElement('tr');
                tr.className = 'item-row';
                tr.innerHTML = `
                    <td class="row-num"></td>
                    <td><input class="form-control item-desc" /></td>
                    <td><input type="number" min="1" value="1" class="form-control item-qty" /></td>
                    <td><input type="number" step="0.01" min="0" value="0" class="form-control item-price" /></td>
                    <td class="text-end item-total">0.00</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger remove-row">×</button>
                    </td>
                `;
                return tr;
            }

            addBtn.addEventListener('click', () => {
                body.appendChild(buildRow());
                renumberRows();
                recalc();
            });

            body.addEventListener('input', recalc);
            vatCheck.addEventListener('change', recalc);

            body.addEventListener('click', (e) => {
                if (e.target.classList.contains('remove-row')) {
                    const rows = body.querySelectorAll('.item-row');
                    if (rows.length > 1) {
                        e.target.closest('.item-row').remove();
                        renumberRows();
                        recalc();
                    }
                }
            });

            // Initial calc on page load
            recalc();
        })();
    </script>
}